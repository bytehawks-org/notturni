# Copiare in .env e adattare i valori. Non committare mai il file .env reale.
# Tutte le variabili hanno il prefisso NOCT_ (CLAUDE.md #3) e sono lette da
# backend/app/core/config.py (Settings, pydantic-settings) — nome variabile
# in maiuscolo = nome campo in minuscolo, stesso ordine di questo file.

# "local": abilita il log verboso delle query SQL (SQLAlchemy echo, vedi
# app/core/database.py) — comodo in sviluppo, da evitare altrove (rumore nei
# log, nessun impatto funzionale). Qualunque altro valore (es. "production")
# lo disattiva; non controlla nient'altro.
NOCT_APP_ENV=local

# Identità dell'istanza (utile per chi self-hosta il progetto): hostname/FQDN
# pubblico (solo informativo/di riferimento, non usato per instradare
# richieste) e nome breve usato come namespace nei path S3 (evita collisioni
# tra più installazioni sullo stesso bucket/endpoint condiviso).
NOCT_INSTANCE_FQDN=notturni.eu
NOCT_SITE_SLUG=notturni
# "solo": pensata per un singolo proprietario, registrazione chiusa dopo il
# primo utente. "platform": multiutente (default, comportamento CLAUDE.md).
NOCT_DEPLOYMENT_MODE=platform

# Bootstrap del primo Super Admin, creato all'avvio del backend se non esiste
# già (idempotente — non serve promuoverlo a mano via SQL). Lasciare una
# delle tre vuota per disattivare il bootstrap (nessun Super Admin creato).
NOCT_SUPER_ADMIN_USERNAME=superadmin
NOCT_SUPER_ADMIN_EMAIL=admin@notturni.eu
NOCT_SUPER_ADMIN_PASSWORD=changeme123!

# Origini ammesse dal backend per le chiamate del frontend dal browser (CORS),
# separate da virgola — deve includere ogni origine (schema+host+porta) da
# cui il frontend viene effettivamente servito, browser incluso (in locale
# http://localhost:3000; in produzione l'origine https pubblica). Richiesto
# anche perché il cookie di sessione sotto viaggia con allow_credentials=True
# (app/main.py): un'origine assente qui non riceve né invia quel cookie.
NOCT_CORS_ORIGINS=http://localhost:3000

# Cookie di sessione (refresh token, httpOnly — vedi backend/API.md, sezione
# "Due meccanismi di autenticazione distinti"). Qui sotto: valori per lo
# sviluppo locale in http (Podman compose, http://localhost). Il default nel
# codice (app/core/config.py, usato se questa variabile è del tutto assente
# dall'ambiente) è invece Secure=true — il valore corretto non appena
# l'istanza è raggiunta in https, produzione o un test su K3s con TLS già
# attivo: alzarlo esplicitamente a "true" a quel punto, altrimenti il
# browser accetta comunque il cookie ma senza la protezione Secure.
# NOCT_SESSION_COOKIE_DOMAIN va valorizzato solo se frontend e backend
# condividono un dominio genitore (es. ".notturni.eu") e il cookie deve
# attraversarne i sottodomini.
NOCT_SESSION_COOKIE_SECURE=false
NOCT_SESSION_COOKIE_SAMESITE=lax
NOCT_SESSION_COOKIE_DOMAIN=

# Invalidazione on-demand della cache dei Server Component del frontend
# (Next.js) dopo una modifica a contenuti pubblici (publish/update di un post,
# config/impostazioni di un blog, pagine statiche). Il backend fa una POST
# fire-and-forget a NOCT_FRONTEND_REVALIDATE_URL con i tag da invalidare; il
# secret deve coincidere tra backend e frontend. Con `podman compose up` sono
# già impostate in compose.yaml (URL per nome servizio, secret di sviluppo):
# qui bastano per un eventuale avvio manuale / per la produzione. Lasciando
# vuoto NOCT_REVALIDATE_SECRET la funzione è disattivata e la cache si
# riallinea solo entro la finestra a tempo (60s, frontend/src/lib/revalidate.ts).
NOCT_FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
NOCT_REVALIDATE_SECRET=

# Manutenzione di audit_log (app/workers/audit_maintenance.py, servizio
# worker-audit-maintenance in compose.yaml). RETENTION_DAYS: giorni di eventi
# tenuti nel database; il job non cancella comunque mai eventi non ancora
# archiviati (la finestra non archiviata è il limite duro). Default 105
# (~15 settimane), così restano sempre almeno 90 giorni interrogabili.
NOCT_AUDIT_RETENTION_DAYS=105
# ARCHIVE_ENABLED=false disattiva lo scarico su storage: il job cancella
# soltanto in base a RETENTION_DAYS.
NOCT_AUDIT_ARCHIVE_ENABLED=true
# Bucket dedicato agli archivi NDJSON gzippati, sempre privato.
NOCT_S3_BUCKET_AUDIT=notturni-audit

# Backup infrastrutturale periodico di Postgres e MinIO/S3 verso uno storage
# S3 **esterno** (app/workers/backup.py, servizio worker-backup in
# compose.yaml) — distinto dal backup applicativo dei singoli post
# (worker-post-backup), che resta nello stesso bucket applicativo. Vuoto
# (default): il worker resta inattivo, nessun tentativo di scrivere su un
# bucket non configurato. Con `podman compose up`, compose.yaml lo punta di
# default allo stesso MinIO locale su un bucket dedicato solo per avere
# qualcosa di verificabile in sviluppo: in produzione va sempre puntato a un
# provider realmente esterno e separato da quello dei contenuti.
NOCT_BACKUP_S3_BUCKET=
NOCT_BACKUP_S3_ENDPOINT_URL=
NOCT_BACKUP_S3_REGION=
NOCT_BACKUP_S3_ACCESS_KEY_ID=
NOCT_BACKUP_S3_SECRET_ACCESS_KEY=

# Database applicativo (PostgreSQL, motore SQLAlchemy async — vedi
# app/core/config.py::database_url). In locale punta al servizio "postgres"
# di compose.yaml, creato con queste stesse credenziali (POSTGRES_USER/
# _PASSWORD/_DB passate al container, vedi compose.yaml); in produzione va
# puntato a un'istanza gestita separatamente, con password propria.
NOCT_POSTGRES_USER=admin
NOCT_POSTGRES_PASSWORD=foo
NOCT_POSTGRES_DB=notturni
NOCT_POSTGRES_HOST=localhost
NOCT_POSTGRES_PORT=5432

# Message broker (RabbitMQ, AMQP) per le code asincrone: OTP via email
# (email_otp_consumer.py), backup dei singoli post (post_backup worker) e
# altri worker in background — vedi compose.yaml per l'elenco completo dei
# servizi worker-*. In locale punta al servizio "rabbitmq" di compose.yaml.
NOCT_RABBITMQ_USER=admin
NOCT_RABBITMQ_PASSWORD=foo
NOCT_RABBITMQ_HOST=localhost
NOCT_RABBITMQ_PORT=5672

# Rate limiting (backend/app/domain/rate_limit.py: login e anteprima link) e
# lock distribuiti. Nessuna password in locale, un Redis irraggiungibile
# disattiva solo il rate limiting (fail open), non blocca mai una richiesta
# legittima. NOCT_REDIS_DB seleziona il database logico Redis (0-15,
# default 0) — utile per isolare istanze condivise (es. la suite di test usa
# NOCT_REDIS_DB=1, vedi backend/.env.test, per non toccare i contatori di
# un'istanza di sviluppo in esecuzione sullo stesso Redis).
NOCT_REDIS_HOST=localhost
NOCT_REDIS_PORT=6379
NOCT_REDIS_DB=0

# Backend di storage per media/avatar/backup post: "s3" (default — MinIO in
# locale, AWS S3/Cloudflare R2/qualunque endpoint S3-compatible in
# produzione) oppure "localstorage" (filesystem locale servito dal backend
# stesso, vedi blocco commentato più sotto — pensato per chi self-hosta in
# modalità "solo" senza voler gestire uno storage S3-compatible).
NOCT_STORAGE_BACKEND=s3

NOCT_S3_ACCESS_KEY_ID=admin
NOCT_S3_SECRET_ACCESS_KEY=foobarfoobar
# lasciare entrambe vuote per autenticarsi via ruolo AWS (instance
# profile/IRSA, variabili AWS_* d'ambiente) invece di una chiave esplicita —
# non ha senso in locale con MinIO, utile in produzione su AWS/EKS.
NOCT_S3_ENDPOINT_URL=http://localhost:9000
# lasciare vuoto in locale: si usa NOCT_S3_ENDPOINT_URL anche per i link
# pubblici. Su AWS S3 vero, valorizzare esplicitamente (l'endpoint API e
# l'URL pubblico degli oggetti non coincidono necessariamente).
NOCT_S3_PUBLIC_URL=
# richiesta solo per AWS S3 vero (o quando si usa il ruolo AWS sopra);
# irrilevante per MinIO locale
NOCT_S3_REGION=
NOCT_S3_BUCKET_AVATARS=avatars
# media incorporati nei post + backup del markdown
NOCT_S3_BUCKET_CONTENT=notturni-content

# Alternativa a NOCT_STORAGE_BACKEND=s3 sopra: storage su filesystem locale.
# base_path: radice su disco (montare un volume persistente se il container
# viene ricreato); public_url: base URL sotto cui il backend serve quei file
# (StaticFiles su /storage, app/main.py) — deve essere raggiungibile dal
# browser, non solo in rete interna.
# NOCT_STORAGE_BACKEND=localstorage
# NOCT_LOCAL_STORAGE_BASE_PATH=./data/storage
# NOCT_LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/storage

# Moderazione automatica delle immagini (nudità/contenuti sensibili),
# self-hosted — vedi moderation/. Impostato automaticamente da compose.yaml
# quando si usa `podman compose up` (non serve toccarlo qui); lasciare vuoto
# disattiva la moderazione (nessuna chiamata, mai bloccante) — utile se si
# avvia il backend da solo, fuori da compose, senza il servizio moderation.
NOCT_MODERATION_SERVICE_URL=

# SMTP per l'invio reale del codice MFA via email (app/core/mail.py,
# app/workers/email_otp_consumer.py). Impostato automaticamente da
# compose.yaml verso il servizio "mailhog" (catcher locale, UI su
# http://localhost:8025 — nessuna email lascia la macchina). Vuoto:
# l'OTP resta solo loggato dal consumer, comodo in sviluppo ma mai il caso
# in produzione, dove va sempre puntato a un provider SMTP/transazionale reale.
NOCT_SMTP_HOST=
NOCT_SMTP_PORT=587
NOCT_SMTP_USER=
NOCT_SMTP_PASSWORD=
NOCT_SMTP_USE_TLS=true
NOCT_SMTP_FROM_EMAIL=no-reply@notturni.eu

# Servizio SMTP containerizzato alternativo (compose.yaml: "smtp-relay",
# k8s/smtp-relay.yaml) — un'opzione in più oltre a puntare NOCT_SMTP_HOST
# direttamente a un provider esterno: boky/postfix, che spedisce
# direttamente (RELAY* vuoti — richiede comunque un dominio con SPF/DKIM/
# reverse DNS a posto per una buona deliverability) o inoltra verso uno
# smarthost esterno con queste credenziali. Per usare questo servizio come
# invio reale: NOCT_SMTP_HOST=smtp-relay, NOCT_SMTP_PORT=587,
# NOCT_SMTP_USE_TLS=false (in locale, rete interna di compose).
NOCT_SMTP_RELAY_HOST=
NOCT_SMTP_RELAY_USERNAME=
NOCT_SMTP_RELAY_PASSWORD=

# NOCT_JWT_SECRET: firma i JWT di sessione — access token (15 min di default)
# e challenge MFA (5 min di default) emessi da app/core/security.py. Un
# refresh token opaco (non JWT) è invece hashato e salvato in tabella
# (UserSession) — vedi app/domain/auth.py — e viaggia solo nel cookie
# httpOnly sopra, mai firmato con questo secret.
# NOCT_SESSION_SECRET: richiesto da Authlib/Starlette (SessionMiddleware) per
# firmare lo state/nonce del flow OAuth2/OIDC durante il login SSO — non
# c'entra con le sessioni utente sopra, nonostante il nome.
# Per entrambi, generare valori casuali per ambienti reali, es.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
NOCT_JWT_SECRET=foo
NOCT_SESSION_SECRET=foo
# Durata di access token/refresh token/challenge MFA — di norma non serve
# toccarli, valori commentati = default applicati dal codice se assenti.
# NOCT_JWT_ACCESS_TOKEN_TTL_MINUTES=15
# NOCT_JWT_REFRESH_TOKEN_TTL_DAYS=30
# NOCT_JWT_MFA_CHALLENGE_TTL_MINUTES=5

# SSO: opzionali, richiesti solo per abilitare il relativo provider
# (CLAUDE.md #3) — un provider senza client id/secret valorizzati risulta
# semplicemente non configurato (503 su /auth/sso/{provider}/login), nessun
# errore di avvio. Client id/secret si ottengono registrando l'app OAuth2/
# OIDC sulla console di sviluppatori di ciascun provider (redirect URI:
# {NOCT_OAUTH_REDIRECT_BASE_URL}/api/v1/auth/sso/{provider}/callback).
# BASE_URL: host pubblico del backend (non del frontend) usato per comporre
# quel redirect URI.
NOCT_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
NOCT_OAUTH_GOOGLE_CLIENT_ID=
NOCT_OAUTH_GOOGLE_CLIENT_SECRET=
NOCT_OAUTH_MICROSOFT_CLIENT_ID=
NOCT_OAUTH_MICROSOFT_CLIENT_SECRET=
NOCT_OAUTH_GITHUB_CLIENT_ID=
NOCT_OAUTH_GITHUB_CLIENT_SECRET=
NOCT_OAUTH_LINKEDIN_CLIENT_ID=
NOCT_OAUTH_LINKEDIN_CLIENT_SECRET=

# Cloudflare Turnstile: captcha per i commenti aperti a tutti (comments_mode
# "everyone", vedi ROADMAP.md §1). Vuoto: quella modalità non è selezionabile
# per nessun blog/post di questa istanza (400 esplicito). Site key pubblica
# (safe da esporre, letta anche dal frontend via GET /api/v1/config), secret
# key mai esposta.
NOCT_TURNSTILE_SITE_KEY=
NOCT_TURNSTILE_SECRET_KEY=
