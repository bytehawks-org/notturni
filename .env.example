# Copiare in .env e adattare i valori. Non committare mai il file .env reale.

NOCT_APP_ENV=local

# Identità dell'istanza (utile per chi self-hosta il progetto): hostname/FQDN
# pubblico e nome breve usato come namespace nei path S3.
NOCT_INSTANCE_FQDN=notturni.eu
NOCT_SITE_SLUG=notturni
# "solo": pensata per un singolo proprietario, registrazione chiusa dopo il
# primo utente. "platform": multiutente (default, comportamento CLAUDE.md).
NOCT_DEPLOYMENT_MODE=platform

# Bootstrap del primo Super Admin, creato all'avvio del backend se non esiste
# già (idempotente — non serve promuoverlo a mano via SQL). Lasciare una
# delle tre vuota per disattivare il bootstrap (nessun Super Admin creato).
NOCT_SUPER_ADMIN_USERNAME=superadmin
NOCT_SUPER_ADMIN_EMAIL=admin@notturni.eu
NOCT_SUPER_ADMIN_PASSWORD=changeme123!

# Origini ammesse dal backend per le chiamate dal browser (CORS), separate da
# virgola — include anche l'app admin (frontend/admin/), origine distinta dal
# frontend pubblico
NOCT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

NOCT_POSTGRES_USER=admin
NOCT_POSTGRES_PASSWORD=foo
NOCT_POSTGRES_DB=notturni
NOCT_POSTGRES_HOST=localhost
NOCT_POSTGRES_PORT=5432

NOCT_RABBITMQ_USER=admin
NOCT_RABBITMQ_PASSWORD=foo
NOCT_RABBITMQ_HOST=localhost
NOCT_RABBITMQ_PORT=5672

NOCT_MINIO_ROOT_USER=admin
NOCT_MINIO_ROOT_PASSWORD=foobarfoobar
NOCT_MINIO_ENDPOINT_URL=http://localhost:9000
# lasciare vuoto in locale: si usa NOCT_MINIO_ENDPOINT_URL anche per i link pubblici
NOCT_MINIO_PUBLIC_URL=
NOCT_MINIO_BUCKET_AVATARS=avatars
# media incorporati nei post + backup del markdown
NOCT_MINIO_BUCKET_CONTENT=notturni-content

# Moderazione automatica delle immagini (nudità/contenuti sensibili),
# self-hosted — vedi moderation/. Impostato automaticamente da compose.yaml
# quando si usa `podman compose up` (non serve toccarlo qui); lasciare vuoto
# disattiva la moderazione (nessuna chiamata, mai bloccante) — utile se si
# avvia il backend da solo, fuori da compose, senza il servizio moderation.
NOCT_MODERATION_SERVICE_URL=

# Sessioni utente: generare valori casuali per ambienti reali,
# es. python -c "import secrets; print(secrets.token_urlsafe(48))"
NOCT_JWT_SECRET=foo
NOCT_SESSION_SECRET=foo

# SSO: opzionali, richiesti solo per abilitare il relativo provider (CLAUDE.md #3)
NOCT_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
NOCT_OAUTH_GOOGLE_CLIENT_ID=
NOCT_OAUTH_GOOGLE_CLIENT_SECRET=
NOCT_OAUTH_MICROSOFT_CLIENT_ID=
NOCT_OAUTH_MICROSOFT_CLIENT_SECRET=
NOCT_OAUTH_GITHUB_CLIENT_ID=
NOCT_OAUTH_GITHUB_CLIENT_SECRET=
NOCT_OAUTH_LINKEDIN_CLIENT_ID=
NOCT_OAUTH_LINKEDIN_CLIENT_SECRET=
