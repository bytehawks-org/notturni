# Valori fissi per la suite di test (backend/tests/), non per lo sviluppo
# locale (per quello vedi ../.env.example). Nessun segreto reale: sicuro da
# committare. NOCT_POSTGRES_DB è volutamente diverso da quello di sviluppo —
# i test droppano e ricreano tutto lo schema ad ogni run.

NOCT_APP_ENV=test

NOCT_POSTGRES_USER=admin
NOCT_POSTGRES_PASSWORD=foo
NOCT_POSTGRES_DB=notturni_test
NOCT_POSTGRES_HOST=localhost
NOCT_POSTGRES_PORT=5432

NOCT_RABBITMQ_USER=admin
NOCT_RABBITMQ_PASSWORD=foo
NOCT_RABBITMQ_HOST=localhost
NOCT_RABBITMQ_PORT=5672

NOCT_S3_ACCESS_KEY_ID=admin
NOCT_S3_SECRET_ACCESS_KEY=foobarfoobar
NOCT_S3_ENDPOINT_URL=http://localhost:9000
NOCT_S3_BUCKET_AVATARS=avatars-test

NOCT_JWT_SECRET=test-jwt-secret-at-least-32-bytes-long
NOCT_SESSION_SECRET=test-session-secret-at-least-32-bytes-long

NOCT_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
