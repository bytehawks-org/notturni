# Proxy di lettura pubblica davanti a Garage (S3-compatible).
#
# Garage non implementa le bucket policy (PutBucketPolicy -> 501): gli oggetti
# pubblici si servono dal suo web endpoint (:3902), che risolve il bucket
# dall'header Host e non conosce URL path-style. Il backend però costruisce
# link `{NOCT_S3_PUBLIC_URL}/{bucket}/{key}` (app/core/storage.py::_public_url):
# questo proxy li traduce in `Host: {bucket}` + `/{key}`, esponendo SOLO i
# prefissi pubblici e SOLO in lettura. Tutto il resto (listing, post
# .../posts/*.md, archivi di audit, backup) risponde 404: la restrizione per
# prefisso che con le bucket policy S3 stava nello storage, qui sta nel proxy.
#
# Variabili sostituite all'avvio (immagine nginx, NGINX_ENVSUBST_FILTER=^NOCT_):
#   NOCT_S3_BUCKET_AVATARS, NOCT_S3_BUCKET_CONTENT, NOCT_GARAGE_WEB_UPSTREAM
#   (host:porta del web endpoint di Garage).

upstream garage_web {
    server ${NOCT_GARAGE_WEB_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    # sola lettura
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_hide_header Set-Cookie;
    # i nomi file sono UUID e gli oggetti non vengono mai sovrascritti: la
    # cache può essere aggressiva. Senza `always`, add_header si applica solo
    # alle risposte 2xx/3xx: un 404 non finisce mai in cache per un anno.
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # avatar e favicon dei blog: intero bucket pubblico
    location ~ ^/${NOCT_S3_BUCKET_AVATARS}/.+$ {
        rewrite ^/${NOCT_S3_BUCKET_AVATARS}/(.*)$ /$1 break;
        proxy_set_header Host ${NOCT_S3_BUCKET_AVATARS};
        proxy_pass http://garage_web;
    }

    # media incorporati nei post: {site_slug}/userdata/{user}/{blog}/media/{file}
    location ~ ^/${NOCT_S3_BUCKET_CONTENT}/[^/]+/userdata/[^/]+/[^/]+/media/[^/]+$ {
        rewrite ^/${NOCT_S3_BUCKET_CONTENT}/(.*)$ /$1 break;
        proxy_set_header Host ${NOCT_S3_BUCKET_CONTENT};
        proxy_pass http://garage_web;
    }

    location / {
        return 404;
    }
}
