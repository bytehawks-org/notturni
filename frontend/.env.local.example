# Copiare in .env.local per lo sviluppo locale (npm run dev, non containerizzato).
# NEXT_PUBLIC_*: valore inglobato nel bundle a build time (vedi Dockerfile per
# l'equivalente in container). Non serve copiarlo per lavorare con
# `podman compose`: il default già punta a localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
